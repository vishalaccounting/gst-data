{
  "name": "Vishal Accounting Services – GST Data",
  "short_name": "Vishal GST",
  "description": "Meesho, Amazon, Flipkart, Vyapar रिपोर्ट और बिल भेजें – GST रिटर्न के लिए",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0d3b66",
  "lang": "hi",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["application/*", "text/*", "image/*", ".xlsx", ".xls", ".csv", ".zip", ".pdf"] }]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
